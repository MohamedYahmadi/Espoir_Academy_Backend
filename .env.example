PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/espoir_academy

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Admin Default Credentials (seeded on first start)
ADMIN_EMAIL=admin@espoir.tn
ADMIN_PASSWORD=change_this_strong_password

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=you@gmail.com

# Frontend URL (for email links)
CLIENT_URL=http://localhost:3000

# CORS allow-list (comma-separated). Required in production.
CORS_ORIGINS=http://localhost:3000

# Rate limiting (window in ms, max requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15

# File storage (uploads). Use "local" (disk) or "s3" (object storage).
STORAGE_DRIVER=local
# Required only when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
